# 複製成 .env（chmod 600）。密碼與密鑰不要貼進聊天、不要進 repo。
APP_ENV=production
AUTH_MODE=oidc
PORTAL_HTTP_PORT=8002
PUBLIC_BASE_URL=https://10.11.1.40:8445
TRUST_PROXY=true

# 產生：openssl rand -hex 32   （與 EC Portal 的值不同）
SESSION_SECRET=
INTERNAL_API_SECRET=

# NAS Postgres（埠 5433），資料庫 extdir、帳號 extdir_app；密碼含特殊字元要做百分比編碼
DATABASE_URL=postgresql+psycopg2://extdir_app:CHANGE_ME@10.11.1.40:5433/extdir?sslmode=disable

# authentik 新增應用（slug: extdir）。ISSUER 結尾要有斜線，用 9000 入口，不要用 9443
OIDC_ISSUER=http://10.11.1.40:9000/application/o/extdir/
OIDC_CLIENT_ID=extdir
OIDC_CLIENT_SECRET=

# 廠區代號 -> authentik 群組（JSON）
PLANT_ADMIN_GROUPS={"1":"Portal-Dir-Admins"}
PUBLIC_RATE_LIMIT_PER_MIN=60
